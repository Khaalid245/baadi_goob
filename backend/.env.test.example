# =============================================================================
# Baadi Goob - Integration Test Environment Variables Template
# =============================================================================
# Copy this file to .env.test before running local integration tests:
#   cp .env.test.example .env.test (or Copy-Item .env.test.example .env.test)
#
# IMPORTANT:
# Integration tests are enforced to run ONLY against a dedicated test database
# named exactly 'furan_test'. Any other database name will fail-closed.
# =============================================================================

# Dedicated test database URL (MUST specify database 'furan_test')
DATABASE_URL="mysql://root:your_local_test_password@localhost:3306/furan_test"

# Dedicated test JWT secret (minimum 32 characters for HMAC-SHA256)
# Do not reuse the production or local development secret.
JWT_SECRET="test_only_dedicated_jwt_signing_key_32_bytes_min_sample"

# Frontend origin for CORS restriction
FRONTEND_URL="http://localhost:5173"

# Runtime environment flag
NODE_ENV="test"
